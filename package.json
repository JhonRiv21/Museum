{
  "name": "museo",
  "private": true,
  "version": "0.1.0",
  "description": "3D virtual museum in the browser: a guided tour through real scanned museum pieces.",
  "author": {
    "name": "Jhon Rivero",
    "url": "https://jhon.riverogz.com/"
  },
  "license": "MIT",
  "homepage": "https://museum.riverogz.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JhonRiv21/Museum.git"
  },
  "type": "module",
  "scripts": {
    "copy:draco": "mkdir -p public/draco public/basis && cp node_modules/three/examples/jsm/libs/draco/gltf/* public/draco/ && cp node_modules/three/examples/jsm/libs/basis/* public/basis/",
    "predev": "npm run copy:draco",
    "prebuild": "npm run copy:draco",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
