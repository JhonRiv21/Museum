---
import "../museum/styles.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏛️</text></svg>"
    />
    <title>Museo virtual · Recorrido 3D por piezas reales</title>
    <meta name="author" content="Jhon Rivero · https://jhon.riverogz.com/" />
    <meta
      name="description"
      content="Recorrido 3D interactivo por piezas reales de museo digitalizadas — esqueletos, fósiles y objetos históricos en dominio público."
    />
    <style is:inline>
      html { background: #0a0e14; }
      #hud, #panel, #loader, #nav, #hint { visibility: hidden; }
    </style>
  </head>
  <body>
    <div id="app"></div>

    <header id="hud">
      <div class="brand">
        <span class="dot"></span>
        <strong>Museo</strong>
        <span class="hall" id="hudHall">Vestíbulo</span>
      </div>
      <button class="hudBtn" id="fullscreen" type="button" aria-label="Pantalla completa" aria-pressed="false" data-state="off">
        <svg class="iconEnter" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
        <svg class="iconExit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
      </button>
    </header>

    <p id="hint">Desplázate para recorrer · clic en una pieza para acercarte</p>

    <aside id="panel" hidden>
      <header>
        <p class="species" id="panelSpecies"></p>
        <h2 id="panelName"></h2>
      </header>
      <ul id="panelFacts"></ul>
      <button id="panelClose" type="button">← Volver al recorrido</button>
    </aside>

    <aside id="credits" aria-label="Autoría" aria-hidden="true">
      <p class="kicker">Desarrollado por</p>
      <p class="author">Jhon Rivero</p>
      <p class="links">
        <a href="https://github.com/JhonRiv21/Museum" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://jhon.riverogz.com/" target="_blank" rel="noopener">Portafolio <span aria-hidden="true">↗</span></a>
      </p>
    </aside>

    <nav id="nav" aria-label="Controles de navegación">
      <div id="railNav">
        <button class="navBtn" id="navForward" type="button" aria-label="Avanzar por el recorrido">▲</button>
        <button class="navBtn" id="navBack" type="button" aria-label="Retroceder por el recorrido">▼</button>
      </div>
      <div id="zoomNav" hidden>
        <button class="navBtn" id="navZoomIn" type="button" aria-label="Acercar">+</button>
        <button class="navBtn" id="navZoomOut" type="button" aria-label="Alejar">−</button>
      </div>
    </nav>

    <div id="loader" hidden>
      <div class="box">
        <p class="loadingHall" id="loaderHall"></p>
        <p class="pct"><span id="loaderPct">0</span>%</p>
        <div class="track"><div id="loaderBar"></div></div>
      </div>
    </div>

    <script>
      import "../museum/main";
    </script>
  </body>
</html>
